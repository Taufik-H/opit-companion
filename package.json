{
  "name": "opit-companion",
  "displayName": "OPIT Companion",
  "description": "Your tiny coding companion.",
  "version": "0.2.9",
  "publisher": "Taufik-H",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Taufik-H/opit-companion.git"
  },
  "keywords": [
    "companion",
    "pet",
    "sprite",
    "cursor",
    "animation",
    "pixel-art",
    "vibecoding"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage",
    "onView:opit.sidebarView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opit-companion-view",
          "title": "OPIT Companion",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "opit-companion-view": [
        {
          "type": "webview",
          "id": "opit.sidebarView",
          "name": "OPIT Dashboard",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "opit.changeVariant",
        "title": "OPIT: Change Character Skin"
      },
      {
        "command": "opit.applySettings",
        "title": "OPIT: Apply Cursor Settings"
      },
      {
        "command": "opit.testError",
        "title": "OPIT: Trigger Test Error Reaction \ud83e\udd12"
      },
      {
        "command": "opit.testSave",
        "title": "OPIT: Trigger Test Save Reaction \ud83c\udf89"
      },
      {
        "command": "opit.toggleEnabled",
        "title": "OPIT Companion: Toggle Active / Inactive"
      }
    ],
    "configuration": {
      "title": "OPIT Companion Settings",
      "properties": {
        "opit.variant": {
          "type": "string",
          "default": "pink",
          "enum": [
            "pink",
            "blue",
            "white",
            "werewolf_black",
            "werewolf_red",
            "werewolf_white",
            "ninja_monk",
            "ninja_peasant",
            "ninja_kunoichi",
            "knight_1",
            "knight_2",
            "knight_3",
            "mage_fire",
            "mage_lightning",
            "mage_wanderer",
            "orc_berserk",
            "orc_shaman",
            "orc_warrior",
            "slime_blue",
            "slime_green",
            "slime_red",
            "warrior_1",
            "warrior_2",
            "warrior_3"
          ],
          "enumDescriptions": [
            "Pink Monster (Retro Hero)",
            "Blue Hero (Retro Hero)",
            "White Chocobo (Retro Hero)",
            "Shadow Werewolf (Black Werewolf)",
            "Blood Werewolf (Red Werewolf)",
            "Frost Werewolf (White Werewolf)",
            "Ninja Monk (Cyan Ninja)",
            "Shadow Shinobi (Purple Ninja)",
            "Kunoichi (Pink Ninja Warrior)",
            "Silver Knight (Knight 1)",
            "Golden Knight (Knight 2)",
            "Dark Paladin (Knight 3)",
            "Fire Wizard (Fire Mage)",
            "Lightning Mage (Lightning Wizard)",
            "Wanderer Mage (Emerald Wizard)",
            "Orc Berserker (Furious Orc)",
            "Orc Shaman (Mystic Orc)",
            "Orc Warrior (Armored Orc)",
            "Blue Slime (Aquatic Slime)",
            "Green Slime (Emerald Slime)",
            "Red Slime (Magma Slime)",
            "Iron Warrior (Warrior 1)",
            "Crimson Warrior (Warrior 2)",
            "Golden Warrior (Warrior 3)"
          ],
          "description": "Choose your OPIT Companion skin variant."
        },
        "opit.animationSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 3,
          "description": "Speed multiplier for OPIT animations."
        },
        "opit.displaySize": {
          "type": "number",
          "default": 22,
          "minimum": 16,
          "maximum": 64,
          "description": "Display size in pixels for OPIT sprite (default 22px to fit standard editor line height)."
        },
        "opit.showCursor": {
          "type": "boolean",
          "default": false,
          "description": "Show or hide the native IDE text cursor alongside OPIT Companion."
        },
        "opit.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable OPIT Companion."
        }
      }
    },
    "keybindings": [
      {
        "command": "opit.cursorDown",
        "key": "down",
        "when": "editorTextFocus && !suggestWidgetVisible && !renameInputVisible && !inQuickOpen && !quickFixWidgetVisible && !parameterHintsVisible"
      },
      {
        "command": "opit.cursorLeft",
        "key": "left",
        "when": "editorTextFocus && !suggestWidgetVisible && !renameInputVisible && !inQuickOpen && !quickFixWidgetVisible && !parameterHintsVisible"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "clean:vsix": "node -e \"const fs=require('fs'); fs.readdirSync('.').filter(f=>f.endsWith('.vsix')).forEach(f=>fs.unlinkSync(f)); console.log('Cleaned old .vsix files')\"",
    "package": "npm run clean:vsix && npx @vscode/vsce package --no-dependencies",
    "vsix": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^18.16.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.1.6"
  },
  "author": "Taufik-H",
  "icon": "assets/icon.png"
}
